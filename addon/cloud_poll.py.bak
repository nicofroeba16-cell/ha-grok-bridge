#!/usr/bin/env python3
"""HA Grok Bridge 0.3.3 – Git command.json + kontrollierter File-Transfer."""
import json
import os
import shutil
import subprocess
import time
from datetime import datetime, timezone
from pathlib import Path

HOME = Path(os.environ.get("BRIDGE_HOME", "/data"))
LAST_ID = HOME / "last_id"
RESULT_LOCAL = HOME / "result.json"
CLONE = HOME / "bridge-push"
OPTIONS = Path("/data/options.json")

DEFAULT_REPO = "git@github.com:nicofroeba16-cell/ha-grok-bridge.git"
VERSION = "0.3.3"

ALLOWED_PREFIXES = (
    "ha info",
    "ha core info",
    "ha core check",
    "ha core stats",
    "ha core restart",
    "ha supervisor info",
    "ha host info",
    "ha resolution info",
    "git -C /config ",
    "bash /config/deploy.sh",
    "python3 /config/apply_updates.py",
    "mkdir -p /config/",
    "cp -f /config/",
)

TRANSFER_PREFIX = "bridge transfer "


def log(msg):
    print(msg, flush=True)


def load_options():
    opts = {"poll_interval": 15, "git_repo": DEFAULT_REPO}
    if OPTIONS.exists():
        try:
            raw = json.loads(OPTIONS.read_text())
            if isinstance(raw, dict):
                opts.update(raw)
        except (OSError, json.JSONDecodeError) as exc:
            log("[-] options.json: %s" % exc)
    return opts


def allowed(cmd):
    c = cmd.strip()

    if c.startswith(TRANSFER_PREFIX):
        return True

    parts = [p.strip() for p in c.replace("&&", ";").split(";") if p.strip()]
    if not parts:
        return False

    for p in parts:
        if p.startswith("true") or p.startswith("echo "):
            continue
        if not any(p.startswith(pre) or p == pre.rstrip()
                   for pre in ALLOWED_PREFIXES):
            return False
    return True


def git_env():
    env = os.environ.copy()
    env["GIT_AUTHOR_NAME"] = "ha-grok-bridge"
    env["GIT_AUTHOR_EMAIL"] = "bridge@local"
    env["GIT_COMMITTER_NAME"] = "ha-grok-bridge"
    env["GIT_COMMITTER_EMAIL"] = "bridge@local"
    key = Path("/data/ssh/id_ed25519")
    known_hosts = Path("/data/.ssh/known_hosts")
    if not key.is_file():
        log("[-] SSH KEY FEHLT: %s" % key)
        return env
    if not known_hosts.is_file():
        log("[-] known_hosts FEHLT: %s" % known_hosts)
        return env
    env["GIT_SSH_COMMAND"] = (
        "ssh -i /data/ssh/id_ed25519 "
        "-o IdentitiesOnly=yes "
        "-o BatchMode=yes "
        "-o StrictHostKeyChecking=yes "
        "-o UserKnownHostsFile=/data/.ssh/known_hosts"
    )
    log("[bridge] GIT_SSH_COMMAND: expliziter Add-on-Key")
    log("[bridge] SSH-Key vorhanden: ja")
    log("[bridge] known_hosts vorhanden: ja")
    return env


def git_run(args, timeout=180, check=False):
    proc = subprocess.run(
        args,
        capture_output=True,
        text=True,
        timeout=timeout,
        env=git_env(),
    )

    out = (proc.stdout or "")
    err = (proc.stderr or "")

    combined = (out + ("\n" + err if err else "")).strip()

    if proc.returncode != 0:
        log(
            "[-] git %s exit=%s %s"
            % (" ".join(args[1:]), proc.returncode, combined[:800])
        )

        if check:
            raise subprocess.CalledProcessError(
                proc.returncode,
                args,
                combined,
            )

    return proc.returncode, combined


def normalize_repo(repo):
    r = (repo or DEFAULT_REPO).strip()

    if r.startswith("https://github.com/"):
        r = "git@github.com:" + r[len("https://github.com/"):]
        if not r.endswith(".git"):
            r = r.rstrip("/") + ".git"

    return r or DEFAULT_REPO


def git_clone_or_fetch(repo):
    repo = normalize_repo(repo)

    if CLONE.exists() and not (CLONE / ".git").exists():
        shutil.rmtree(CLONE)

    if not CLONE.exists():
        git_run(
            ["git", "clone", "--depth", "1", repo, str(CLONE)],
            check=True,
        )
    else:
        git_run(
            ["git", "-C", str(CLONE), "remote", "set-url", "origin", repo],
            check=True,
        )

        git_run(
            ["git", "-C", str(CLONE), "fetch", "origin", "main"],
            check=True,
        )

        git_run(
            ["git", "-C", str(CLONE), "reset", "--hard", "origin/main"],
            check=True,
        )


def fetch_command(repo):
    try:
        git_clone_or_fetch(repo)

        text = (CLONE / "command.json").read_text()
        payload = json.loads(text)

    except (subprocess.SubprocessError, OSError, json.JSONDecodeError) as exc:
        log("[-] command.json: %s" % exc)
        return None

    if (
        not isinstance(payload, dict)
        or not payload.get("id")
        or not payload.get("command")
    ):
        return None

    return payload


def run_command(cmd):
    if cmd.strip().startswith(TRANSFER_PREFIX):
        return transfer_file(cmd.strip())

    if not allowed(cmd):
        return 1, "ABGEBROCHEN: nicht in der Whitelist!"

    if not Path("/config").is_dir():
        return 1, "ABGEBROCHEN: /config fehlt im Add-on."

    env = os.environ.copy()

    proc = subprocess.run(
        cmd,
        shell=True,
        text=True,
        capture_output=True,
        timeout=180,
        cwd=str(HOME),
        env=env,
    )

    out = (proc.stdout or "")
    err = (proc.stderr or "")

    return proc.returncode, (out + ("\n" + err if err else "")).strip()


def transfer_file(cmd):
    """
    Syntax:
      bridge transfer /config/relative/path destination/relative/path

    Es dürfen ausschließlich Dateien unter /config übertragen werden.
    """

    parts = cmd.split()

    if len(parts) != 4:
        return 2, (
            "Syntax: bridge transfer "
            "/config/<quelle> <ziel-im-repository>"
        )

    source = Path(parts[2]).resolve()
    destination = parts[3].strip("/")

    config_root = Path("/config").resolve()
    repo_root = CLONE.resolve()

    try:
        source.relative_to(config_root)
    except ValueError:
        return 2, "ABGEBROCHEN: Quelle muss unter /config liegen."

    if not source.is_file():
        return 2, "ABGEBROCHEN: Quelldatei existiert nicht: %s" % source

    if not destination or ".." in Path(destination).parts:
        return 2, "ABGEBROCHEN: ungültiges Repository-Ziel."

    try:
        git_clone_or_fetch(DEFAULT_REPO)
    except Exception as exc:
        return 1, "Git Clone/Fetch fehlgeschlagen: %s" % exc

    dest = (repo_root / destination).resolve()

    try:
        dest.relative_to(repo_root)
    except ValueError:
        return 2, "ABGEBROCHEN: Ziel liegt außerhalb des Repositorys."

    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source, dest)

    code, out = git_run(
        ["git", "-C", str(CLONE), "add", "--", destination],
        check=True,
    )

    code, status = git_run(
        ["git", "-C", str(CLONE), "status", "--short"],
        check=True,
    )

    if not status.strip():
        return 0, "Keine Änderung: %s ist bereits aktuell." % destination

    message = "transfer: %s" % destination

    git_run(
        ["git", "-C", str(CLONE), "commit", "-m", message],
        check=True,
    )

    git_run(
        ["git", "-C", str(CLONE), "push", "origin", "HEAD:main"],
        check=True,
    )

    return 0, "Transfer erfolgreich: %s -> GitHub main" % destination


def write_result(entry, repo):
    blob = json.dumps(
        entry,
        ensure_ascii=False,
        indent=2,
    ) + "\n"

    RESULT_LOCAL.write_text(blob)

    try:
        git_clone_or_fetch(repo)

        dest = CLONE / "result.json"
        dest.write_text(blob)

        git_run(
            ["git", "-C", str(CLONE), "add", "result.json"],
            check=True,
        )

        code, status = git_run(
            ["git", "-C", str(CLONE), "status", "--short"],
            check=True,
        )

        if status.strip():
            git_run(
                [
                    "git",
                    "-C",
                    str(CLONE),
                    "commit",
                    "-m",
                    "update result.json",
                ],
                check=True,
            )

            git_run(
                ["git", "-C", str(CLONE), "push", "origin", "HEAD:main"],
                check=True,
            )

    except (subprocess.SubprocessError, OSError, RuntimeError) as exc:
        log("[-] result.json push fail: %s" % exc)


def main():
    HOME.mkdir(parents=True, exist_ok=True)

    opts = load_options()

    interval = int(opts.get("poll_interval") or 15)

    repo = normalize_repo(
        str(opts.get("git_repo") or DEFAULT_REPO)
    )

    last = (
        LAST_ID.read_text().strip()
        if LAST_ID.exists()
        else ""
    )

    log(
        "Add-on-Poller %s · Git + File Transfer · repo=%s · interval=%ss"
        % (VERSION, repo, interval)
    )

    log("Kein SSH zum Host. /config lokal.")

    while True:
        payload = fetch_command(repo)

        if payload:
            cid = str(payload["id"])

            if cid != last:
                cmd = str(payload["command"])

                if not last:
                    LAST_ID.write_text(cid + "\n")
                    last = cid
                    log(
                        "[*] first boot: arm last_id=%s, skip exec"
                        % cid
                    )
                else:
                    log(
                        "[+] Neuer Befehl (ID %s): %s"
                        % (cid, cmd)
                    )

                    try:
                        code, out = run_command(cmd)
                    except Exception as exc:
                        code = 1
                        out = "Exception: %s" % exc

                    log("[+] Ergebnis exit=%s" % code)
                    log(out or "(leer)")

                    write_result(
                        {
                            "id": cid,
                            "command": cmd,
                            "exit_code": code,
                            "ok": code == 0,
                            "output": out,
                            "ts": datetime.now(timezone.utc).strftime(
                                "%Y-%m-%dT%H:%M:%SZ"
                            ),
                            "via": "addon-%s" % VERSION,
                        },
                        repo,
                    )

                    LAST_ID.write_text(cid + "\n")
                    last = cid

        time.sleep(interval)


if __name__ == "__main__":
    main()
