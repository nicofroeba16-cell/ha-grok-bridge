#!/bin/bash
# 0.3.2 – Git + File Transfer
set -euo pipefail

log() { echo "[bridge] $*" ; }

log "HA Grok Bridge Add-on 0.3.2 – Git + File Transfer"

mkdir -p /data/ssh /data/.ssh
chmod 700 /data/ssh /data/.ssh

KEY=""
if [[ -f /ssl/ha-grok-bridge-new ]]; then
  KEY=/ssl/ha-grok-bridge-new
elif [[ -f /data/ssh/id_ed25519 ]]; then
  KEY=/data/ssh/id_ed25519
elif [[ -f /data/ssh/id_rsa ]]; then
  KEY=/data/ssh/id_rsa
fi

if [[ -z "$KEY" ]]; then
  log "WARN kein Git-SSH-Key"
  exit 1
fi

cp -f "$KEY" /data/ssh/id_ed25519
chmod 600 /data/ssh/id_ed25519

ssh-keyscan -t rsa,ecdsa,ed25519 github.com \
  >> /data/.ssh/known_hosts 2>/dev/null || true
chmod 600 /data/.ssh/known_hosts || true

export GIT_SSH_COMMAND="ssh -i /data/ssh/id_ed25519 -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/data/.ssh/known_hosts"

log "Git-SSH-Key: /data/ssh/id_ed25519 (von $KEY)"
log "GIT_SSH_COMMAND: expliziter Add-on-Key"

if [[ ! -d /config && -d /homeassistant ]]; then
  ln -sfn /homeassistant /config
  log "WARN /config Link -> /homeassistant"
fi

if [[ ! -d /config ]]; then
  log "FATAL /config nicht gemappt"
  exit 1
fi

log "/config ok"
